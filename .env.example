# --- GoHighLevel (subcuenta Oficina Prime) ---
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx
GHL_API_VERSION=2021-07-28

# Cómo se identifica el agente en cada contacto de GHL.
# Opciones: "assignedTo" (usuario asignado del contacto) o "customField:<fieldKey>"
GHL_AGENT_SOURCE=assignedTo

# Cómo se identifica la oficina en cada contacto de GHL.
# Opciones: "fixed:<nombre>" (una sola oficina, valor fijo), "tag" (primer tag del contacto)
# o "customField:<fieldKey>"
GHL_OFFICE_SOURCE=fixed:Oficina Prime

# Tag que marca a un contacto como "registrado" en el broker (lo pone el
# workflow de n8n al momento del registro). Usado para la columna Registros.
GHL_REGISTRO_TAG=tag-julian-registrado

# Regla 1 para contar un lead: tag que el agente pone a mano en cada contacto
# nuevo que entra por la pauta. Sin este tag no cuenta como lead.
GHL_LEAD_TAG=ingreso de pauta

# --- Postgres (mismo servidor donde corre n8n) ---
DATABASE_URL=postgresql://usuario:password@host:5432/oficina_prime

# --- Acceso al dashboard (single user) ---
DASHBOARD_PASSWORD=cambia-esto
SESSION_SECRET=genera-un-string-aleatorio-largo

# Token que usa el cron del server para llamar a /api/cron/tag-snapshot.
CRON_SECRET=genera-un-string-aleatorio-largo
